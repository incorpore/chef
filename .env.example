# Copie para .env (que NUNCA vai para o Git) e preencha.
NODE_ENV=production
PORT=3000
BASE_URL=https://seusite.com.br

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Primeiro acesso: OU defina o admin aqui (apague depois de criado) OU use o token de instalação
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
SETUP_TOKEN=

# Opcional
DATA_DIR=./data
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=200
PAGE_CACHE_SECONDS=15
# Quantos proxies reversos (Nginx/Caddy/Cloudflare) existem na frente do app — afeta o IP usado nos limites
TRUST_PROXY=1
