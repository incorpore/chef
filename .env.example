# Copie para .env (que NUNCA vai para o Git) e preencha.
NODE_ENV=production
PORT=3000
BASE_URL=https://seusite.com.br

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Primeiro acesso: OU defina o admin aqui (apague depois de criado) OU use o token de instalação
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
SETUP_TOKEN=

# Opcional
DATA_DIR=./data
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=200
PAGE_CACHE_SECONDS=15
# Quantos proxies reversos (Nginx/Caddy/Cloudflare) existem na frente do app — afeta o IP usado nos limites
TRUST_PROXY=1

# E-mail (opcional): esqueci a senha, avisos de comentário, newsletter. Vazio = desligado.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 e SMTP_PASS = "senha de app" (exige verificação em 2 etapas)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true   # automático na porta 465
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_ADMIN=
MAIL_RATE_PER_MIN=30
